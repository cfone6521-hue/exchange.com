# GEMINI_API_KEY: Required for optional Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
PORT=3000

# Backend Web3 Auth Secret (used for signing session tokens)
JWT_SECRET="rv_web3_super_secure_session_secret_change_in_production"

# Admin Wallet Public Address (EVM address authorized for administrative dashboard)
ADMIN_WALLET_ADDRESS="0x70997970C51812dc3A010C7d01b50e0d17dc79C8"

# Blockchain RPC Endpoints (Default public fallbacks provided in code; configure private nodes here)
RPC_ETHEREUM="https://rpc.ankr.com/eth"
RPC_POLYGON="https://polygon-rpc.com"
RPC_BSC="https://bsc-dataseed.binance.org"
RPC_ARBITRUM="https://arb1.arbitrum.io/rpc"
RPC_OPTIMISM="https://mainnet.optimism.io"
RPC_BASE="https://mainnet.base.org"
RPC_SEPOLIA="https://rpc.sepolia.org"

# WalletConnect Cloud Project ID (Optional - get one for free at https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID="c4f79cc821944d9680842e34466bfbd"

